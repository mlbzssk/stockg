# DeepSeek（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Finnhub（分析美股时必填）
FINNHUB_API_KEY=

# 本地 RAG 与日志
RAG_STORE_PATH=./.rag_store
LOG_LEVEL=INFO

# Langfuse（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 仅当本机 HTTPS 代理导致证书校验失败、且确认需要绕过代理时启用。
# NO_PROXY=*
# no_proxy=*
